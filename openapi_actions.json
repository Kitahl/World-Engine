        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "x-openai-isConsequential": false
      }
    },
    "/api/presentation": {
      "post": {
        "summary": "Publish Presentation",
        "description": "Validate and durably publish exact accepted narration without mutating world state.",
